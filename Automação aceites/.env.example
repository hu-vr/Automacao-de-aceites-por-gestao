# Configuração do Jira
JIRA_DOMAIN=minhaempresa.atlassian.net
JIRA_EMAIL=seu_email@empresa.com
JIRA_API_TOKEN=SEU_API_TOKEN
JIRA_BASE_URL=https://minhaempresa.atlassian.net

# Configuração do SMTP / Outlook
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=seu_email@empresa.com
SMTP_PASSWORD=SUA_SENHA_OU_APP_PASSWORD
SENDER_EMAIL=seu_email@empresa.com

